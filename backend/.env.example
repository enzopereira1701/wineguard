# Copie este arquivo para ".env" (na mesma pasta) e ajuste. O ".env" NÃO vai para o GitHub.

# Onde estão o Orion (1026) e o STH-Comet (8666).
# Backend no seu PC: use o IP público da instância da AWS (muda a cada sessão do lab)
# ou o nome do DuckDNS (wineguard-cp5.duckdns.org).
# Backend dentro da instância (a partir de 19/10, com Docker Compose): localhost.
FIWARE_HOST=wineguard-cp5.duckdns.org

# Vinheria e adega usadas nesta etapa (a partir do Backend 4 vêm do cadastro de vinherias)
FIWARE_SERVICE=vin_demo
FIWARE_SERVICEPATH=/adega1

# Quem pode chamar a API pelo navegador (separe por vírgula). Depois da Vercel, acrescente o endereço do site.
CORS_ORIGINS=http://localhost:5173

# Segundos sem leitura para o dispositivo contar como offline
OFFLINE_SEGUNDOS=30

# --- Cadastro de dispositivos (Backend 2)
# apikey do grupo de dispositivos (vai no tópico MQTT do Node: /<apikey>/<device_id>/attrs)
FIWARE_APIKEY=winedemo
NOME_VINHERIA=Vinheria Demo
