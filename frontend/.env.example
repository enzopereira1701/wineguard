# Copie para .env (o .env NÃO vai para o GitHub) e troque o IP a cada sessão do lab.
# true = dados de mentira; false = backend real
VITE_USE_MOCK=false
# backend FastAPI (rodando local ou na instância)
VITE_API_URL=http://localhost:8000
# IP público da instância AWS (mostrado no bloco de config.h do Node)
VITE_MQTT_HOST=0.0.0.0
